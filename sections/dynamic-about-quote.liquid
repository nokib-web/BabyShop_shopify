{% assign bg_color = section.settings.background_color | default: '#f4f7f6' %}

<section
  class="about-quote-section section-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="about-quote"
  style="--about-quote-bg: {{ bg_color }};"
>
  {% if section.settings.show_botanical_decor %}
    <div class="about-quote__decor about-quote__decor--left" aria-hidden="true">
      <svg width="180" height="180" viewBox="0 0 180 180" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M10 170C10 90 70 30 160 10C130 80 80 140 10 170Z" fill="{{ settings.color_links | default: '#4a7875' }}" fill-opacity="0.07"/>
        <path d="M25 150C45 105 85 65 140 30" stroke="{{ settings.color_links | default: '#4a7875' }}" stroke-width="1.2" stroke-linecap="round" stroke-opacity="0.2"/>
      </svg>
    </div>
    <div class="about-quote__decor about-quote__decor--right" aria-hidden="true">
      <svg width="180" height="180" viewBox="0 0 180 180" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M170 10C170 90 110 150 20 170C50 100 100 40 170 10Z" fill="{{ settings.color_links | default: '#4a7875' }}" fill-opacity="0.07"/>
        <path d="M155 30C135 75 95 115 40 150" stroke="{{ settings.color_links | default: '#4a7875' }}" stroke-width="1.2" stroke-linecap="round" stroke-opacity="0.2"/>
      </svg>
    </div>
  {% endif %}

  <div class="about-quote__container">
    <div class="about-quote__content">
      {% if section.settings.kicker != blank %}
        <span class="about-quote__kicker">{{ section.settings.kicker }}</span>
      {% endif %}

      {% if section.settings.title != blank %}
        <h2 class="about-quote__title">{{ section.settings.title }}</h2>
      {% endif %}

      <div class="about-quote__divider" aria-hidden="true">
        <svg width="40" height="10" viewBox="0 0 40 10" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 5C8 9 14 1 20 5C26 9 32 1 38 5" stroke="{{ settings.color_links | default: '#4a7875' }}" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </div>

      {% if section.settings.quote != blank %}
        <blockquote class="about-quote__statement">
          {{ section.settings.quote }}
        </blockquote>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <p class="about-quote__subtext">
          {{ section.settings.subtext }}
        </p>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .section-{{ section.id }} {
    background-color: var(--about-quote-bg);
    padding: clamp(4rem, 7vw, 6.5rem) 1.5rem;
    position: relative;
    overflow: hidden;
    text-align: center;
  }

  .about-quote__container {
    max-width: {{ settings.layout_max_width | default: 900 }}px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .about-quote__decor {
    position: absolute;
    pointer-events: none;
    z-index: 1;
  }

  .about-quote__decor--left {
    top: -20px;
    left: -20px;
  }

  .about-quote__decor--right {
    bottom: -20px;
    right: -20px;
  }

  .about-quote__content {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .about-quote__kicker {
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 700;
    color: {{ settings.color_links | default: '#4a7875' }};
    margin-bottom: 0.5rem;
  }

  .about-quote__title {
    color: {{ settings.color_headings | default: '#2f5054' }};
    font-size: clamp(1.85rem, 3.2vw, 2.75rem);
    margin: 0 0 0.5rem;
    font-weight: 700;
  }

  .about-quote__divider {
    margin: 0.2rem 0 2rem;
  }

  .about-quote__statement {
    margin: 0 0 1.5rem 0;
    padding: 0;
    border: none;
    color: {{ settings.color_headings | default: '#2f5054' }};
    font-size: clamp(1.2rem, 1.8vw, 1.55rem);
    font-weight: 500;
    line-height: 1.6;
    font-style: italic;
    max-width: 780px;
  }

  .about-quote__subtext {
    color: {{ settings.color_text | default: '#3a4a4b' }};
    font-size: 1rem;
    line-height: 1.7;
    margin: 0;
    max-width: 620px;
    opacity: 0.9;
  }
</style>

{% schema %}
{
  "name": "About - Philosophy Quote",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f4f7f6"
    },
    {
      "type": "checkbox",
      "id": "show_botanical_decor",
      "label": "Show Botanical Leaf Accents",
      "default": true
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow / Subtitle",
      "default": "OUR PHILOSOPHY"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Our Belief"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Inspirational Quote",
      "default": "“We believe nature knows best. An infant's world should begin with warmth, gentle pure fabrics, and conscious choices.”"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext / Signature",
      "default": "— For your baby, for your peace of mind, and for the world they grow up in."
    }
  ],
  "presets": [
    {
      "name": "About - Philosophy Quote",
      "category": "About"
    }
  ]
}
{% endschema %}
