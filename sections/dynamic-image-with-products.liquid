<script
  type="application/json"
  data-section-type="dynamic-image-with-products"
  data-section-id="{{ section.id }}">
</script>

<style>
  .image-with-products__{{ section.id }} {
    background-color: {{ section.settings.background_color | default: '#edf7fc' }};
    padding-top: {{ section.settings.padding_top | default: 70 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 70 }}px;
    margin-top: {{ section.settings.margin_top | default: 40 }}px;
    margin-bottom: {{ section.settings.margin_bottom | default: 40 }}px;
    width: 100%;
    overflow: hidden;
    clear: both;
    position: relative;
    z-index: 1;
    box-sizing: border-box;
  }

  .image-with-products__{{ section.id }} .iwp-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }

  /* Header Styles */
  .image-with-products__{{ section.id }} .iwp-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .image-with-products__{{ section.id }} .iwp-title {
    font-size: 32px;
    font-weight: 700;
    color: {{ section.settings.heading_color | default: '#2f5054' }};
    margin: 0 0 8px 0;
    line-height: 1.25;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .image-with-products__{{ section.id }} .iwp-subheading {
    font-size: 16px;
    font-weight: 400;
    color: {{ section.settings.subheading_color | default: '#4a7875' }};
    margin: 0;
    line-height: 1.45;
  }

  /* Main Grid */
  .image-with-products__{{ section.id }} .iwp-main-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 36px;
    align-items: stretch;
  }

  {% if section.settings.layout == 'image_right' %}
    .image-with-products__{{ section.id }} .iwp-hero-col {
      order: 2;
    }
    .image-with-products__{{ section.id }} .iwp-products-col {
      order: 1;
    }
  {% endif %}

  /* Hero Banner Card - Generous Height */
  .image-with-products__{{ section.id }} .iwp-hero-card {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    min-height: 500px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background-color: #8da6a3;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.05);
    text-decoration: none;
    box-sizing: border-box;
  }

  .image-with-products__{{ section.id }} .iwp-hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
  }

  .image-with-products__{{ section.id }} .iwp-hero-card:hover .iwp-hero-image {
    transform: scale(1.03);
  }

  .image-with-products__{{ section.id }} .iwp-hero-overlay {
    position: absolute;
    inset: 0;
    background-color: {{ section.settings.overlay_color | default: '#000000' }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 | default: 0.15 }};
    z-index: 1;
  }

  .image-with-products__{{ section.id }} .iwp-hero-text {
    position: relative;
    z-index: 2;
    padding: 30px 24px;
    color: #ffffff;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.35;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
    max-width: 85%;
  }

  .image-with-products__{{ section.id }} .iwp-placeholder-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #7c9f9c 0%, #4a7875 100%);
  }

  /* Products Column */
  .image-with-products__{{ section.id }} .iwp-products-col {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }

  .image-with-products__{{ section.id }} .iwp-products-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    flex-grow: 1;
    align-items: stretch;
  }

  /* Individual Product Card - Generous Height & Crisp Padding */
  .image-with-products__{{ section.id }} .iwp-product-card {
    background: #ffffff;
    border-radius: 24px;
    padding: 32px 20px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    min-height: 420px;
    height: 100%;
    box-sizing: border-box;
    position: relative;
    justify-content: space-between;
  }

  .image-with-products__{{ section.id }} .iwp-product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.09);
  }

  .image-with-products__{{ section.id }} .iwp-product-media {
    width: 100%;
    height: 230px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    overflow: hidden;
  }

  .image-with-products__{{ section.id }} .iwp-product-img {
    max-height: 210px;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    transition: transform 0.35s ease;
  }

  .image-with-products__{{ section.id }} .iwp-product-card:hover .iwp-product-img {
    transform: scale(1.05);
  }

  .image-with-products__{{ section.id }} .iwp-product-placeholder-svg {
    width: 100px;
    height: 100px;
    color: #4a7875;
    opacity: 0.65;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-with-products__{{ section.id }} .iwp-product-placeholder-svg svg {
    width: 80px;
    height: 80px;
  }

  .image-with-products__{{ section.id }} .iwp-product-info {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-grow: 1;
    justify-content: flex-end;
  }

  .image-with-products__{{ section.id }} .iwp-product-title {
    font-size: 15px;
    font-weight: 700;
    color: {{ section.settings.heading_color | default: '#2f5054' }};
    line-height: 1.4;
    margin: 0 0 10px 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .image-with-products__{{ section.id }} .iwp-product-price {
    font-size: 16px;
    font-weight: 700;
    color: {{ section.settings.price_color | default: '#4a7875' }};
    margin: 0;
  }

  .image-with-products__{{ section.id }} .iwp-product-price-compare {
    text-decoration: line-through;
    color: #999999;
    font-weight: 400;
    font-size: 13px;
    margin-left: 6px;
  }

  /* Bottom CTA Button */
  .image-with-products__{{ section.id }} .iwp-action-wrapper {
    text-align: center;
    margin-top: 40px;
  }

  .image-with-products__{{ section.id }} .iwp-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 40px;
    border-radius: 30px;
    background-color: {{ section.settings.button_bg | default: '#4a7875' }};
    color: {{ section.settings.button_color | default: '#ffffff' }};
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 4px 16px rgba(74, 120, 117, 0.25);
  }

  .image-with-products__{{ section.id }} .iwp-btn:hover {
    filter: brightness(0.92);
    transform: translateY(-2px);
    box-shadow: 0 6px 22px rgba(74, 120, 117, 0.35);
    color: {{ section.settings.button_color | default: '#ffffff' }};
  }

  /* Responsive Adjustments */
  @media screen and (max-width: 959px) {
    .image-with-products__{{ section.id }} {
      padding-top: 45px;
      padding-bottom: 45px;
      margin-top: 25px;
      margin-bottom: 25px;
    }

    .image-with-products__{{ section.id }} .iwp-container {
      padding: 0 16px;
    }

    .image-with-products__{{ section.id }} .iwp-main-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .image-with-products__{{ section.id }} .iwp-hero-col {
      order: 1 !important;
    }

    .image-with-products__{{ section.id }} .iwp-products-col {
      order: 2 !important;
    }

    .image-with-products__{{ section.id }} .iwp-desktop-header {
      display: none;
    }

    .image-with-products__{{ section.id }} .iwp-mobile-header {
      display: block;
      margin-bottom: 24px;
    }

    .image-with-products__{{ section.id }} .iwp-title {
      font-size: 26px;
    }

    .image-with-products__{{ section.id }} .iwp-subheading {
      font-size: 14px;
    }

    .image-with-products__{{ section.id }} .iwp-hero-card {
      min-height: 300px;
      border-radius: 18px;
    }

    .image-with-products__{{ section.id }} .iwp-hero-text {
      font-size: 22px;
    }

    .image-with-products__{{ section.id }} .iwp-products-grid {
      gap: 14px;
    }

    .image-with-products__{{ section.id }} .iwp-product-card {
      padding: 20px 12px;
      border-radius: 18px;
      min-height: 320px;
    }

    .image-with-products__{{ section.id }} .iwp-product-media {
      height: 160px;
      margin-bottom: 12px;
    }

    .image-with-products__{{ section.id }} .iwp-product-img {
      max-height: 150px;
    }

    .image-with-products__{{ section.id }} .iwp-product-title {
      font-size: 13px;
    }

    .image-with-products__{{ section.id }} .iwp-product-price {
      font-size: 14px;
    }

    .image-with-products__{{ section.id }} .iwp-action-wrapper {
      margin-top: 28px;
    }

    .image-with-products__{{ section.id }} .iwp-btn {
      padding: 11px 32px;
      font-size: 14px;
    }
  }

  @media screen and (min-width: 960px) {
    .image-with-products__{{ section.id }} .iwp-mobile-header {
      display: none;
    }
    .image-with-products__{{ section.id }} .iwp-desktop-header {
      display: block;
    }
  }
</style>

<section class="image-with-products__{{ section.id }}">
  <div class="iwp-container">
    
    {% comment %} Mobile Header (Shown at top on smaller screens) {% endcomment %}
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="iwp-header iwp-mobile-header">
        {% if section.settings.title != blank %}
          <h2 class="iwp-title">{{ section.settings.title | escape }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="iwp-subheading">{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="iwp-main-grid">
      
      {% comment %} Hero Feature Image Card {% endcomment %}
      <div class="iwp-hero-col">
        {% if section.settings.image_link != blank %}
          <a href="{{ section.settings.image_link }}" class="iwp-hero-card">
        {% else %}
          <div class="iwp-hero-card">
        {% endif %}

          {% if section.settings.image != blank %}
            <img
              class="iwp-hero-image"
              src="{{ section.settings.image | image_url: width: 1200 }}"
              srcset="{{ section.settings.image | image_url: width: 500 }} 500w,
                      {{ section.settings.image | image_url: width: 900 }} 900w,
                      {{ section.settings.image | image_url: width: 1200 }} 1200w"
              sizes="(max-width: 959px) 100vw, 50vw"
              alt="{{ section.settings.image.alt | default: section.settings.image_overlay_heading | escape }}"
              loading="lazy"
            >
          {% else %}
            <div class="iwp-placeholder-bg"></div>
          {% endif %}

          <div class="iwp-hero-overlay"></div>

          {% if section.settings.image_overlay_heading != blank %}
            <div class="iwp-hero-text">
              {{ section.settings.image_overlay_heading | newline_to_br }}
            </div>
          {% endif %}

        {% if section.settings.image_link != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}
      </div>

      {% comment %} Products Column {% endcomment %}
      <div class="iwp-products-col">
        
        {% comment %} Desktop Header (Shown above products on desktop) {% endcomment %}
        {% if section.settings.title != blank or section.settings.subheading != blank %}
          <div class="iwp-header iwp-desktop-header">
            {% if section.settings.title != blank %}
              <h2 class="iwp-title">{{ section.settings.title | escape }}</h2>
            {% endif %}
            {% if section.settings.subheading != blank %}
              <p class="iwp-subheading">{{ section.settings.subheading | escape }}</p>
            {% endif %}
          </div>
        {% endif %}

        <div class="iwp-products-grid">
          
          {%- assign has_custom_products = false -%}
          
          {%- if section.blocks.size > 0 -%}
            {%- assign has_custom_products = true -%}
            {%- for block in section.blocks -%}
              {%- assign prod = block.settings.product -%}
              {%- if prod != blank -%}
                <a href="{{ prod.url }}" class="iwp-product-card" {{ block.shopify_attributes }}>
                  <div class="iwp-product-media">
                    {% if prod.featured_media != blank %}
                      <img
                        class="iwp-product-img"
                        src="{{ prod.featured_media | image_url: width: 500 }}"
                        alt="{{ prod.title | escape }}"
                        loading="lazy"
                      >
                    {% else %}
                      <div class="iwp-product-placeholder-svg">
                        {% render 'icon-library', id: 'icon-bag' %}
                      </div>
                    {% endif %}
                  </div>
                  <div class="iwp-product-info">
                    <h3 class="iwp-product-title">{{ prod.title }}</h3>
                    <div class="iwp-product-price">
                      {{ prod.price | money }}
                      {% if prod.compare_at_price > prod.price %}
                        <span class="iwp-product-price-compare">{{ prod.compare_at_price | money }}</span>
                      {% endif %}
                    </div>
                  </div>
                </a>
              {%- else -%}
                <div class="iwp-product-card" {{ block.shopify_attributes }}>
                  <div class="iwp-product-media">
                    <div class="iwp-product-placeholder-svg">
                      {% render 'icon-library', id: 'icon-bag' %}
                    </div>
                  </div>
                  <div class="iwp-product-info">
                    <h3 class="iwp-product-title">Organic Baby Swaddle</h3>
                    <div class="iwp-product-price">$39.95</div>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          
          {%- elsif section.settings.product_1 != blank or section.settings.product_2 != blank -%}
            {%- assign has_custom_products = true -%}
            
            {%- if section.settings.product_1 != blank -%}
              {%- assign prod1 = section.settings.product_1 -%}
              <a href="{{ prod1.url }}" class="iwp-product-card">
                <div class="iwp-product-media">
                  {% if prod1.featured_media != blank %}
                    <img class="iwp-product-img" src="{{ prod1.featured_media | image_url: width: 500 }}" alt="{{ prod1.title | escape }}" loading="lazy">
                  {% else %}
                    <div class="iwp-product-placeholder-svg">{% render 'icon-library', id: 'icon-bag' %}</div>
                  {% endif %}
                </div>
                <div class="iwp-product-info">
                  <h3 class="iwp-product-title">{{ prod1.title }}</h3>
                  <div class="iwp-product-price">
                    {{ prod1.price | money }}
                    {% if prod1.compare_at_price > prod1.price %}
                      <span class="iwp-product-price-compare">{{ prod1.compare_at_price | money }}</span>
                    {% endif %}
                  </div>
                </div>
              </a>
            {%- endif -%}

            {%- if section.settings.product_2 != blank -%}
              {%- assign prod2 = section.settings.product_2 -%}
              <a href="{{ prod2.url }}" class="iwp-product-card">
                <div class="iwp-product-media">
                  {% if prod2.featured_media != blank %}
                    <img class="iwp-product-img" src="{{ prod2.featured_media | image_url: width: 500 }}" alt="{{ prod2.title | escape }}" loading="lazy">
                  {% else %}
                    <div class="iwp-product-placeholder-svg">{% render 'icon-library', id: 'icon-bag' %}</div>
                  {% endif %}
                </div>
                <div class="iwp-product-info">
                  <h3 class="iwp-product-title">{{ prod2.title }}</h3>
                  <div class="iwp-product-price">
                    {{ prod2.price | money }}
                    {% if prod2.compare_at_price > prod2.price %}
                      <span class="iwp-product-price-compare">{{ prod2.compare_at_price | money }}</span>
                    {% endif %}
                  </div>
                </div>
              </a>
            {%- endif -%}

          {%- elsif section.settings.collection != blank and collections[section.settings.collection].products.size > 0 -%}
            {%- assign has_custom_products = true -%}
            {%- assign col_products = collections[section.settings.collection].products -%}
            {%- for prod in col_products limit: 2 -%}
              <a href="{{ prod.url }}" class="iwp-product-card">
                <div class="iwp-product-media">
                  {% if prod.featured_media != blank %}
                    <img class="iwp-product-img" src="{{ prod.featured_media | image_url: width: 500 }}" alt="{{ prod.title | escape }}" loading="lazy">
                  {% else %}
                    <div class="iwp-product-placeholder-svg">{% render 'icon-library', id: 'icon-bag' %}</div>
                  {% endif %}
                </div>
                <div class="iwp-product-info">
                  <h3 class="iwp-product-title">{{ prod.title }}</h3>
                  <div class="iwp-product-price">
                    {{ prod.price | money }}
                    {% if prod.compare_at_price > prod.price %}
                      <span class="iwp-product-price-compare">{{ prod.compare_at_price | money }}</span>
                    {% endif %}
                  </div>
                </div>
              </a>
            {%- endfor -%}

          {%- endif -%}

          {%- unless has_custom_products -%}
            {% comment %} Template Default Placeholder Products (AnisBub Baby Essentials) {% endcomment %}
            <div class="iwp-product-card">
              <div class="iwp-product-media">
                <div class="iwp-product-placeholder-svg">
                  {% render 'icon-library', id: 'icon-delivery-package' %}
                </div>
              </div>
              <div class="iwp-product-info">
                <h3 class="iwp-product-title">Organic Cotton Swaddle Wrap</h3>
                <div class="iwp-product-price">$39.95</div>
              </div>
            </div>

            <div class="iwp-product-card">
              <div class="iwp-product-media">
                <div class="iwp-product-placeholder-svg">
                  {% render 'icon-library', id: 'icon-gift' %}
                </div>
              </div>
              <div class="iwp-product-info">
                <h3 class="iwp-product-title">Silicone Teething & Feeding Set</h3>
                <div class="iwp-product-price">$29.95</div>
              </div>
            </div>
          {%- endunless -%}

        </div>
      </div>

    </div>

    {% comment %} Bottom CTA Button {% endcomment %}
    {% if section.settings.button_label != blank %}
      <div class="iwp-action-wrapper">
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="iwp-btn">
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Image with products",
  "class": "image-with-products-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Baby Accessories & Essentials"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Thoughtfully curated essentials for your baby's daily comfort"
    },
    {
      "type": "header",
      "content": "Layout & Colors"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop Image Alignment",
      "options": [
        {
          "value": "image_left",
          "label": "Image on Left"
        },
        {
          "value": "image_right",
          "label": "Image on Right"
        }
      ],
      "default": "image_left"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background Color",
      "default": "#edf7fc"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#2f5054"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#4a7875"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Product Price Color",
      "default": "#4a7875"
    },
    {
      "type": "header",
      "content": "Hero Feature Image Card"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Feature Image"
    },
    {
      "type": "textarea",
      "id": "image_overlay_heading",
      "label": "Text on Image",
      "default": "Must haves for\nDaily Baby Care"
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Image Card Link"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Image Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity (%)",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 15
    },
    {
      "type": "header",
      "content": "Products Selection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection (Pulls top 2 products)"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Or Select Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Or Select Product 2"
    },
    {
      "type": "header",
      "content": "Bottom Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Baby Accessories"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background Color",
      "default": "#4a7875"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section Spacing & Margins"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "min": 20,
      "max": 120,
      "step": 5,
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "min": 20,
      "max": 120,
      "step": 5,
      "default": 70
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top (px) - Space from upper section",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 40
    },
