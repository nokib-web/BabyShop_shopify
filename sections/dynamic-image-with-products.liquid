<script
  type="application/json"
  data-section-type="dynamic-image-with-products"
  data-section-id="{{ section.id }}">
</script>

<style>
  .image-with-products__{{ section.id }} {
    background-color: {{ section.settings.background_color | default: '#edf7fc' }};
    padding-top: {{ section.settings.padding_top | default: 70 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 70 }}px;
    margin-top: {{ section.settings.margin_top | default: 40 }}px;
    margin-bottom: {{ section.settings.margin_bottom | default: 40 }}px;
    width: 100%;
    clear: both;
    position: relative;
    z-index: 1;
    box-sizing: border-box;
  }

  .image-with-products__{{ section.id }} .iwp-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }

  /* Header Styles */
  .image-with-products__{{ section.id }} .iwp-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .image-with-products__{{ section.id }} .iwp-title {
    margin: 0 0 8px 0;
    {% if section.settings.heading_color != blank %}
      color: {{ section.settings.heading_color }};
    {% endif %}
  }

  .image-with-products__{{ section.id }} .iwp-subheading {
    font-size: 16px;
    font-weight: 400;
    color: {{ section.settings.subheading_color | default: '#4a7875' }};
    margin: 0;
    line-height: 1.45;
  }

  /* Main Grid */
  .image-with-products__{{ section.id }} .iwp-main-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 36px;
    align-items: stretch;
  }

  {% if section.settings.layout == 'image_right' %}
    .image-with-products__{{ section.id }} .iwp-hero-col {
      order: 2;
    }
    .image-with-products__{{ section.id }} .iwp-products-col {
      order: 1;
    }
  {% endif %}

  /* Hero Banner Card */
  .image-with-products__{{ section.id }} .iwp-hero-card {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    min-height: 480px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background-color: #8da6a3;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    text-decoration: none;
    box-sizing: border-box;
  }

  .image-with-products__{{ section.id }} .iwp-hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
  }

  .image-with-products__{{ section.id }} .iwp-hero-card:hover .iwp-hero-image {
    transform: scale(1.03);
  }

  .image-with-products__{{ section.id }} .iwp-hero-overlay {
    position: absolute;
    inset: 0;
    background-color: {{ section.settings.overlay_color | default: '#000000' }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 | default: 0.15 }};
    z-index: 1;
  }

  .image-with-products__{{ section.id }} .iwp-hero-text {
    position: relative;
    z-index: 2;
    padding: 30px 24px;
    color: #ffffff;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.35;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
    max-width: 85%;
  }

  .image-with-products__{{ section.id }} .iwp-placeholder-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #7c9f9c 0%, #4a7875 100%);
  }

  /* Products Column */
  .image-with-products__{{ section.id }} .iwp-products-col {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }

  .image-with-products__{{ section.id }} .iwp-products-grid {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 20px !important;
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
    width: 100% !important;
  }

  .image-with-products__{{ section.id }} .iwp-products-grid .productgrid--item {
    width: 100% !important;
    margin: 0 !important;
    max-width: none !important;
  }

  /* Bottom CTA Button */
  .image-with-products__{{ section.id }} .iwp-action-wrapper {
    text-align: center;
    margin-top: 40px;
  }

  .image-with-products__{{ section.id }} .iwp-btn {
    display: inline-block;
  }

  /* Responsive Adjustments */
  @media screen and (max-width: 959px) {
    .image-with-products__{{ section.id }} {
      padding-top: 45px;
      padding-bottom: 45px;
      margin-top: 25px;
      margin-bottom: 25px;
    }

    .image-with-products__{{ section.id }} .iwp-container {
      padding: 0 16px;
    }

    .image-with-products__{{ section.id }} .iwp-main-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .image-with-products__{{ section.id }} .iwp-hero-col {
      order: 1 !important;
    }

    .image-with-products__{{ section.id }} .iwp-products-col {
      order: 2 !important;
    }

    .image-with-products__{{ section.id }} .iwp-desktop-header {
      display: none;
    }

    .image-with-products__{{ section.id }} .iwp-mobile-header {
      display: block;
      margin-bottom: 24px;
    }

    .image-with-products__{{ section.id }} .iwp-subheading {
      font-size: 14px;
    }

    .image-with-products__{{ section.id }} .iwp-hero-card {
      min-height: 280px;
    }

    .image-with-products__{{ section.id }} .iwp-hero-text {
      font-size: 22px;
    }

    .image-with-products__{{ section.id }} .iwp-products-grid {
      gap: 12px !important;
    }

    .image-with-products__{{ section.id }} .iwp-action-wrapper {
      margin-top: 28px;
    }
  }

  @media screen and (min-width: 960px) {
    .image-with-products__{{ section.id }} .iwp-mobile-header {
      display: none;
    }
    .image-with-products__{{ section.id }} .iwp-desktop-header {
      display: block;
    }
  }
</style>

<section class="image-with-products__{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="iwp-container">
    
    {% comment %} Mobile Header (Shown at top on smaller screens) {% endcomment %}
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="iwp-header iwp-mobile-header">
        {% if section.settings.title != blank %}
          <h2 class="home-section--title iwp-title">{{ section.settings.title | escape }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="iwp-subheading">{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="iwp-main-grid">
      
      {% comment %} Hero Feature Image Card {% endcomment %}
      <div class="iwp-hero-col">
        {% if section.settings.image_link != blank %}
          <a href="{{ section.settings.image_link }}" class="iwp-hero-card">
        {% else %}
          <div class="iwp-hero-card">
        {% endif %}

          {% if section.settings.image != blank %}
            <img
              class="iwp-hero-image"
              src="{{ section.settings.image | image_url: width: 1200 }}"
              srcset="{{ section.settings.image | image_url: width: 500 }} 500w,
                      {{ section.settings.image | image_url: width: 900 }} 900w,
                      {{ section.settings.image | image_url: width: 1200 }} 1200w"
              sizes="(max-width: 959px) 100vw, 50vw"
              alt="{{ section.settings.image.alt | default: section.settings.image_overlay_heading | escape }}"
              loading="lazy"
            >
          {% else %}
            <div class="iwp-placeholder-bg"></div>
          {% endif %}

          <div class="iwp-hero-overlay"></div>

          {% if section.settings.image_overlay_heading != blank %}
            <div class="iwp-hero-text">
              {{ section.settings.image_overlay_heading | newline_to_br }}
            </div>
          {% endif %}

        {% if section.settings.image_link != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}
      </div>

      {% comment %} Products Column {% endcomment %}
      <div class="iwp-products-col">
        
        {% comment %} Desktop Header (Shown above products on desktop) {% endcomment %}
        {% if section.settings.title != blank or section.settings.subheading != blank %}
          <div class="iwp-header iwp-desktop-header">
            {% if section.settings.title != blank %}
              <h2 class="home-section--title iwp-title">{{ section.settings.title | escape }}</h2>
            {% endif %}
            {% if section.settings.subheading != blank %}
              <p class="iwp-subheading">{{ section.settings.subheading | escape }}</p>
            {% endif %}
          </div>
        {% endif %}

        <ul class="home-section--content productgrid--items iwp-products-grid" data-layout="grid">
          
          {%- assign has_custom_products = false -%}
          
          {%- if section.blocks.size > 0 -%}
            {%- assign has_custom_products = true -%}
            {%- for block in section.blocks -%}
              {%- assign prod = block.settings.product -%}
              {%- if prod != blank -%}
                {%
                  render 'product-grid-item',
                  product: prod
                %}
              {%- else -%}
                {%
                  render 'product-grid-item',
                  product: false
                %}
              {%- endif -%}
            {%- endfor -%}
          
          {%- elsif section.settings.product_1 != blank or section.settings.product_2 != blank -%}
            {%- assign has_custom_products = true -%}
            
            {%- if section.settings.product_1 != blank -%}
              {%- assign prod1 = section.settings.product_1 -%}
              {%
                render 'product-grid-item',
                product: prod1
              %}
            {%- endif -%}

            {%- if section.settings.product_2 != blank -%}
              {%- assign prod2 = section.settings.product_2 -%}
              {%
                render 'product-grid-item',
                product: prod2
              %}
            {%- endif -%}

          {%- elsif section.settings.collection != blank and collections[section.settings.collection].products.size > 0 -%}
            {%- assign has_custom_products = true -%}
            {%- assign col_products = collections[section.settings.collection].products -%}
            {%- for prod in col_products limit: 2 -%}
              {%
                render 'product-grid-item',
                product: prod
              %}
            {%- endfor -%}

          {%- endif -%}

          {%- unless has_custom_products -%}
            {% for i in (1..2) %}
              {%
                render 'product-grid-item',
                product: false
              %}
            {% endfor %}
          {%- endunless -%}

        </ul>
      </div>

    </div>

    {% comment %} Bottom CTA Button {% endcomment %}
    {% if section.settings.button_label != blank %}
      <div class="iwp-action-wrapper">
        <a
          href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
          class="button-{{ section.settings.cta_button_style | default: 'primary' }} featured-collection__button iwp-btn"
        >
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    {% endif %}

  </div>
</section>

{% render 'quick-shop' %}

{% schema %}
{
  "name": "Image with products",
  "class": "image-with-products-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Baby Accessories & Essentials"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Thoughtfully curated essentials for your baby's daily comfort"
    },
    {
      "type": "header",
      "content": "Layout & Colors"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop Image Alignment",
      "options": [
        {
          "value": "image_left",
          "label": "Image on Left"
        },
        {
          "value": "image_right",
          "label": "Image on Right"
        }
      ],
      "default": "image_left"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background Color",
      "default": "#edf7fc"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#2f5054"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#4a7875"
    },
    {
      "type": "header",
      "content": "Hero Feature Image Card"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Feature Image"
    },
    {
      "type": "textarea",
      "id": "image_overlay_heading",
      "label": "Text on Image",
      "default": "Must haves for\nDaily Baby Care"
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Image Card Link"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Image Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity (%)",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 15
    },
    {
      "type": "header",
      "content": "Products Selection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection (Pulls top 2 products)"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Or Select Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Or Select Product 2"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Baby Accessories"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "cta_button_style",
      "label": "Button style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        }
      ],
      "default": "primary"
    },
    {
      "type": "header",
      "content": "Section Spacing & Margins"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "min": 20,
      "max": 120,
      "step": 5,
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "min": 20,
      "max": 120,
      "step": 5,
      "default": 70
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top (px) - Space from upper section",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin Bottom (px) - Space from lower section",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "category": "Products",
      "name": "Image with products",
      "settings": {
        "title": "Baby Accessories & Essentials",
        "subheading": "Thoughtfully curated essentials for your baby's daily comfort",
        "image_overlay_heading": "Must haves for\nDaily Baby Care",
        "button_label": "Shop Baby Accessories",
        "background_color": "#edf7fc"
      }
    }
  ]
}
{% endschema %}
