<section
  id="about-promise"
  class="about-promise-section section-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="about-promise"
  style="--about-promise-bg: {{ section.settings.background_color | default: '#ffffff' }};"
>
  <div class="about-promise__container">
    <div class="about-promise__header">
      {% if section.settings.kicker != blank %}
        <span class="about-promise__kicker">{{ section.settings.kicker }}</span>
      {% endif %}

      {% if section.settings.title != blank %}
        <h2 class="about-promise__title">{{ section.settings.title }}</h2>
      {% endif %}

      <div class="about-promise__divider" aria-hidden="true">
        <svg width="48" height="12" viewBox="0 0 48 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 6C10 11 18 1 24 6C30 11 38 1 46 6" stroke="{{ settings.color_links | default: '#4a7875' }}" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>

      {% if section.settings.text != blank %}
        <div class="about-promise__text rte">
          {{ section.settings.text }}
        </div>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="about-promise__pillars">
        {% for block in section.blocks %}
          <div class="about-promise__pillar-card" {{ block.shopify_attributes }}>
            <div class="about-promise__pillar-icon-wrap">
              {% case block.settings.icon %}
                {% when 'organic' %}
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22C12 22 20 18 20 12V5L12 2L4 5V12C4 18 12 22 12 22Z"/>
                    <path d="M12 8V16"/>
                    <path d="M8 12H16"/>
                  </svg>
                {% when 'heart' %}
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                  </svg>
                {% when 'feather' %}
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"/>
                    <line x1="16" y1="8" x2="2" y2="22"/>
                    <line x1="17.5" y1="15" x2="9" y2="15"/>
                  </svg>
                {% when 'shield' %}
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    <path d="M9 12l2 2 4-4"/>
                  </svg>
                {% when 'sparkle' %}
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z"/>
                  </svg>
                {% else %}
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
                    <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
                  </svg>
              {% endcase %}
            </div>
            {% if block.settings.title != blank %}
              <h3 class="about-promise__pillar-title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.text != blank %}
              <p class="about-promise__pillar-text">{{ block.settings.text }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .section-{{ section.id }} {
    background-color: var(--about-promise-bg);
    padding: clamp(3rem, 5vw, 5.5rem) 1.5rem;
    position: relative;
  }

  .about-promise__container {
    max-width: {{ settings.layout_max_width | default: 1100 }}px;
    margin: 0 auto;
    text-align: center;
  }

  .about-promise__header {
    max-width: 780px;
    margin: 0 auto clamp(2.5rem, 4vw, 4rem);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .about-promise__kicker {
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 700;
    color: {{ settings.color_links | default: '#4a7875' }};
    margin-bottom: 0.5rem;
  }

  .about-promise__title {
    color: {{ settings.color_headings | default: '#2f5054' }};
    font-size: clamp(1.85rem, 3.2vw, 2.75rem);
    line-height: 1.25;
    margin: 0 0 0.75rem 0;
    font-weight: 700;
  }

  .about-promise__divider {
    margin: 0.25rem 0 1.25rem;
    display: flex;
    justify-content: center;
  }

  .about-promise__text {
    color: {{ settings.color_text | default: '#3a4a4b' }};
    font-size: clamp(1rem, 1.15vw, 1.15rem);
    line-height: 1.8;
  }

  .about-promise__pillars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .about-promise__pillar-card {
    background: {{ settings.color_footer_background | default: '#f4f7f6' }};
    padding: 2.25rem 1.75rem;
    border-radius: 20px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 1px solid rgba(74, 120, 117, 0.1);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .about-promise__pillar-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(47, 80, 84, 0.08);
  }

  .about-promise__pillar-icon-wrap {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ settings.color_links | default: '#4a7875' }};
    margin-bottom: 1.25rem;
    box-shadow: 0 6px 16px rgba(74, 120, 117, 0.12);
  }

  .about-promise__pillar-title {
    color: {{ settings.color_headings | default: '#2f5054' }};
    font-size: 1.2rem;
    margin: 0 0 0.75rem;
    font-weight: 700;
  }

  .about-promise__pillar-text {
    color: {{ settings.color_text | default: '#3a4a4b' }};
    font-size: 0.95rem;
    line-height: 1.65;
    margin: 0;
  }
</style>

{% schema %}
{
  "name": "About - Our Promise",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow / Subtitle",
      "default": "OUR COMMITMENT"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Our Promise"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Promise Statement",
      "default": "<p>Every garment and baby essential in our collection is curated with gentle intention. We hold every stitch to uncompromising standards for quality, safety, and natural softness — because every baby deserves a gentle start and every parent deserves peace of mind.</p>"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Value Pillar",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf / Botanical" },
            { "value": "organic", "label": "Organic Badge" },
            { "value": "feather", "label": "Soft Feather" },
            { "value": "shield", "label": "Safety Shield" },
            { "value": "heart", "label": "Heart Care" },
            { "value": "sparkle", "label": "Sparkle" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Pillar Title",
          "default": "100% Pure & Gentle"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Pillar Description",
          "default": "Natural, breathable fibers that respect fragile newborn skin and soothe delicate senses."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About - Our Promise",
      "category": "About",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "icon": "feather",
            "title": "Silky Soft & Breathable",
            "text": "Ultra-soft natural organic cotton and bamboo that allows newborn skin to breathe comfortably."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "shield",
            "title": "Certified AU Safety",
            "text": "Carefully selected and rigorously tested to meet strict Australian and international safety standards."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "heart",
            "title": "Crafted with Love",
            "text": "Timeless, durable designs made to withstand daily joy and be treasured by growing families."
          }
        }
      ]
    }
  ]
}
{% endschema %}
