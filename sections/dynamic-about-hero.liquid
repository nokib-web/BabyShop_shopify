<script type="application/pxs-animation-mapping+json">
  {
    "blocks": [".about-hero"],
    "elements": [".about-hero__kicker", ".about-hero__title", ".about-hero__text", ".about-hero__button-wrap", ".about-hero__image-wrapper"]
  }
</script>

{% assign bg_color = section.settings.background_color | default: 'transparent' %}
{% assign text_align = section.settings.text_alignment | default: 'left' %}
{% assign img_pos = section.settings.image_position | default: 'right' %}

<section
  class="about-hero-section section-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="about-hero"
  style="--about-hero-bg: {{ bg_color }};"
>
  <div class="about-hero__container">
    {% if section.settings.show_botanical_decor %}
      <div class="about-hero__decor about-hero__decor--top-left" aria-hidden="true">
        <svg width="160" height="160" viewBox="0 0 160 160" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M20 140C20 80 70 30 140 20C120 70 80 120 20 140Z" fill="currentColor" fill-opacity="0.12"/>
          <path d="M35 125C50 90 85 60 125 45" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-opacity="0.25"/>
          <path d="M60 100C50 95 42 85 45 75" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-opacity="0.2"/>
          <path d="M85 75C75 70 67 60 70 50" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-opacity="0.2"/>
        </svg>
      </div>
      <div class="about-hero__decor about-hero__decor--bottom-right" aria-hidden="true">
        <svg width="200" height="200" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M180 20C180 100 120 165 30 180C60 120 110 60 180 20Z" fill="currentColor" fill-opacity="0.08"/>
          <path d="M160 45C135 85 95 130 45 155" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-opacity="0.2"/>
          <path d="M125 75C135 85 145 92 140 102" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-opacity="0.18"/>
        </svg>
      </div>
    {% endif %}

    <div class="about-hero__inner about-hero__inner--img-{{ img_pos }}">
      <!-- Text Content -->
      <div class="about-hero__content about-hero__content--align-{{ text_align }}">
        {% if section.settings.kicker != blank %}
          <div class="about-hero__kicker">
            <span class="about-hero__kicker-text">{{ section.settings.kicker }}</span>
          </div>
        {% endif %}

        {% if section.settings.title != blank %}
          <h1 class="about-hero__title">
            {{ section.settings.title }}
          </h1>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="about-hero__text rte">
            {{ section.settings.text }}
          </div>
        {% endif %}

        {% if section.settings.button_1_label != blank or section.settings.button_2_label != blank %}
          <div class="about-hero__button-wrap">
            {% if section.settings.button_1_label != blank %}
              <a
                href="{{ section.settings.button_1_link | default: routes.all_products_collection_url }}"
                class="button-primary about-hero__btn about-hero__btn--primary"
              >
                {{ section.settings.button_1_label }}
              </a>
            {% endif %}

            {% if section.settings.button_2_label != blank %}
              <a
                href="{{ section.settings.button_2_link | default: '#about-promise' }}"
                class="button-secondary about-hero__btn about-hero__btn--secondary"
              >
                {{ section.settings.button_2_label }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <!-- Hero Visual / Organic Blob Image -->
      <div class="about-hero__visual">
        <div class="about-hero__blob-card">
          <div class="about-hero__blob-aura"></div>
          <div class="about-hero__image-wrapper">
            {% if section.settings.image != blank %}
              <img
                src="{{ section.settings.image | image_url: width: 1000 }}"
                srcset="{{ section.settings.image | image_url: width: 400 }} 400w, {{ section.settings.image | image_url: width: 700 }} 700w, {{ section.settings.image | image_url: width: 1000 }} 1000w"
                sizes="(min-width: 990px) 45vw, 90vw"
                alt="{{ section.settings.image.alt | default: section.settings.title | escape }}"
                class="about-hero__image"
                loading="eager"
                width="{{ section.settings.image.width }}"
                height="{{ section.settings.image.height }}"
              >
            {% else %}
              <div class="about-hero__placeholder">
                <svg viewBox="0 0 500 500" class="about-hero__placeholder-svg" xmlns="http://www.w3.org/2000/svg">
                  <defs>
                    <linearGradient id="heroPlGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#f4f7f6" />
                      <stop offset="100%" stop-color="#e2ece9" />
                    </linearGradient>
                  </defs>
                  <rect width="500" height="500" fill="url(#heroPlGrad)" />
                  <!-- Organic Baby Romper / Leaf Icon Silhouette -->
                  <g transform="translate(150, 110) scale(0.4)" fill="{{ settings.color_headings | default: '#2f5054' }}" opacity="0.45">
                    <path d="M256 64C200 64 160 100 160 140L120 170C110 180 110 200 120 210L160 230L160 380C160 410 180 430 210 430L240 430L240 370C240 360 250 350 256 350C262 350 272 360 272 370L272 430L302 430C332 430 352 410 352 380L352 230L392 210C402 200 402 180 392 170L352 140C352 100 312 64 256 64Z" />
                    <circle cx="256" cy="180" r="14" fill="#ffffff" opacity="0.8" />
                    <circle cx="256" cy="230" r="14" fill="#ffffff" opacity="0.8" />
                    <circle cx="256" cy="280" r="14" fill="#ffffff" opacity="0.8" />
                  </g>
                </svg>
              </div>
            {% endif %}
          </div>

          {% if section.settings.badge_text != blank %}
            <div class="about-hero__floating-badge">
              <span class="about-hero__badge-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <path d="M9 12l2 2 4-4"/>
                </svg>
              </span>
              <span class="about-hero__badge-text">{{ section.settings.badge_text }}</span>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-{{ section.id }} {
    background-color: var(--about-hero-bg);
    position: relative;
    overflow: hidden;
    padding: clamp(3rem, 6vw, 6rem) 1.5rem;
  }

  .about-hero__container {
    max-width: {{ settings.layout_max_width | default: 1300 }}px;
    margin: 0 auto;
    position: relative;
  }

  .about-hero__decor {
    position: absolute;
    pointer-events: none;
    z-index: 1;
    color: {{ settings.color_links | default: '#4a7875' }};
  }

  .about-hero__decor--top-left {
    top: -20px;
    left: -30px;
    opacity: 0.75;
  }

  .about-hero__decor--bottom-right {
    bottom: -40px;
    right: -20px;
    opacity: 0.65;
  }

  .about-hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  @media (min-width: 900px) {
    .about-hero__inner {
      grid-template-columns: 1.15fr 0.95fr;
      gap: 4.5rem;
    }

    .about-hero__inner--img-left {
      grid-template-columns: 0.95fr 1.15fr;
    }

    .about-hero__inner--img-left .about-hero__content {
      order: 2;
    }

    .about-hero__inner--img-left .about-hero__visual {
      order: 1;
    }
  }

  .about-hero__content {
    display: flex;
    flex-direction: column;
  }

  .about-hero__content--align-left {
    align-items: flex-start;
    text-align: left;
  }

  .about-hero__content--align-center {
    align-items: center;
    text-align: center;
  }

  .about-hero__kicker {
    margin-bottom: 1rem;
  }

  .about-hero__kicker-text {
    display: inline-block;
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 700;
    color: {{ settings.color_links | default: '#4a7875' }};
    background: {{ settings.color_footer_background | default: '#f4f7f6' }};
    padding: 0.4rem 1rem;
    border-radius: 50px;
    border: 1px solid rgba(74, 120, 117, 0.15);
  }

  .about-hero__title {
    color: {{ settings.color_headings | default: '#2f5054' }};
    font-size: clamp(2rem, 4.2vw, 3.4rem);
    line-height: 1.18;
    margin: 0 0 1.5rem 0;
    font-weight: 700;
  }

  .about-hero__title em,
  .about-hero__title i {
    font-style: italic;
    font-family: Georgia, serif;
    font-weight: 400;
    color: {{ settings.color_links | default: '#4a7875' }};
  }

  .about-hero__text {
    color: {{ settings.color_text | default: '#3a4a4b' }};
    font-size: clamp(1rem, 1.15vw, 1.125rem);
    line-height: 1.75;
    margin-bottom: 2rem;
    max-width: 600px;
  }

  .about-hero__text p:not(:last-child) {
    margin-bottom: 1rem;
  }

  .about-hero__button-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .about-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50px !important;
    padding: 0.85rem 2.2rem !important;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.3s ease;
    min-height: 48px;
    cursor: pointer;
  }

  .about-hero__btn--primary {
    box-shadow: 0 8px 20px rgba(74, 120, 117, 0.25);
  }

  .about-hero__btn--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 25px rgba(74, 120, 117, 0.35);
  }

  .about-hero__btn--secondary {
    border: 1.5px solid {{ settings.color_button_secondary_border | default: '#4a7875' }} !important;
  }

  .about-hero__btn--secondary:hover {
    transform: translateY(-2px);
    background: {{ settings.color_button_secondary_text | default: '#4a7875' }} !important;
    color: #ffffff !important;
  }

  /* Visual Container with Organic Blob */
  .about-hero__visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .about-hero__blob-card {
    position: relative;
    width: 100%;
    max-width: 480px;
    aspect-ratio: 1 / 1.08;
    margin: 0 auto;
  }

  .about-hero__blob-aura {
    position: absolute;
    inset: -15px;
    background: radial-gradient(circle at 60% 40%, rgba(74, 120, 117, 0.18) 0%, rgba(244, 247, 246, 0.4) 60%, transparent 80%);
    border-radius: 65% 35% 60% 40% / 45% 55% 45% 55%;
    z-index: 1;
    filter: blur(12px);
    animation: aboutBlobFloat 12s ease-in-out infinite alternate;
  }

  .about-hero__image-wrapper {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    border-radius: 60% 40% 50% 50% / 50% 60% 40% 50%;
    overflow: hidden;
    box-shadow: 0 20px 45px rgba(47, 80, 84, 0.12), 0 6px 15px rgba(0, 0, 0, 0.04);
    background: {{ settings.color_footer_background | default: '#f4f7f6' }};
    border: 4px solid #ffffff;
    transition: transform 0.5s ease;
  }

  .about-hero__image-wrapper:hover {
    transform: scale(1.02);
  }

  .about-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .about-hero__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .about-hero__placeholder-svg {
    width: 100%;
    height: 100%;
  }

  .about-hero__floating-badge {
    position: absolute;
    bottom: 20px;
    left: -10px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: #ffffff;
    padding: 0.65rem 1.25rem;
    border-radius: 50px;
    box-shadow: 0 10px 30px rgba(47, 80, 84, 0.15);
    border: 1px solid rgba(74, 120, 117, 0.15);
    color: {{ settings.color_headings | default: '#2f5054' }};
    font-size: 0.85rem;
    font-weight: 700;
    animation: aboutBadgeFloat 5s ease-in-out infinite alternate;
  }

  .about-hero__badge-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ settings.color_links | default: '#4a7875' }};
  }

  @keyframes aboutBadgeFloat {
    0% { transform: translateY(0); }
    100% { transform: translateY(-8px); }
  }

  @keyframes aboutBlobFloat {
    0% { transform: rotate(0deg) scale(1); }
    100% { transform: rotate(4deg) scale(1.04); }
  }

  @media (max-width: 767px) {
    .about-hero__blob-card {
      max-width: 340px;
    }
    .about-hero__floating-badge {
      left: 10px;
      bottom: 10px;
    }
  }
</style>

{% schema %}
{
  "name": "About - Hero Story",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#fbfdfc"
    },
    {
      "type": "checkbox",
      "id": "show_botanical_decor",
      "label": "Show Botanical Leaf Accents",
      "default": true
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow / Subtitle",
      "default": "NATURAL • GENTLE • THOUGHTFUL"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Heading",
      "default": "Welcome to <em>AnisBub</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Story Narrative",
      "default": "<p>At AnisBub, we believe that the earliest days of childhood should be wrapped in pure, natural comfort. Born out of deep care for delicate infant skin, our mission is to provide thoughtfully designed essentials crafted from organic, breathable, and sustainable materials.</p><p>Proudly Australian-owned and dedicated to safety and serenity, we accompany families from their very first precious moments.</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Action Buttons"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Primary Button Label",
      "default": "Shop Our Range"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary Button Label",
      "default": "Our Promise"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Visual & Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Lifestyle Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Floating Pill Badge Text",
      "default": "100% Certified Safe & Pure"
    }
  ],
  "presets": [
    {
      "name": "About - Hero Story",
      "category": "About"
    }
  ]
}
{% endschema %}
