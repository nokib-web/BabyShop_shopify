    "dynamic_testimonials": {
      "type": "dynamic-testimonials",
      "blocks": {
        "testimonial-1": {
          "type": "testimonial",
          "settings": {
            "star_rating": "5",
            "text": "<p>We purchased our baby's cot, mattress, and swaddles from AnisBub. The quality is outstanding and the organic cotton is so gentle on sensitive skin. Arrived so quickly in Sydney!</p>",
            "author": "<p>Sarah M. — Sydney, NSW</p>"
          }
        },
        "testimonial-2": {
          "type": "testimonial",
          "settings": {
            "star_rating": "5",
            "text": "<p>The pram and stroller accessories we ordered made getting out and about with our newborn so much easier. Excellent customer service when we asked about compatibility.</p>",
            "author": "<p>Liam & Jessica — Melbourne, VIC</p>"
          }
        },
        "testimonial-3": {
          "type": "testimonial",
          "settings": {
            "star_rating": "5",
            "text": "<p>Beautiful baby clothes! The fabrics are breathable, super soft, and hold up amazingly after multiple washes. Truly a one-stop baby shop for Australian parents.</p>",
            "author": "<p>Emily R. — Brisbane, QLD</p>"
          }
        },
        "testimonial-4": {
          "type": "testimonial",
          "settings": {
            "star_rating": "5",
            "text": "<p>Love supporting an Australian store! The nursery furniture was easy to assemble, solidly built, and looks gorgeous in our baby room. Highly recommended!</p>",
            "author": "<p>Hannah K. — Melbourne, VIC</p>"
          }
        },
        "testimonial-5": {
          "type": "testimonial",
          "settings": {
            "star_rating": "5",
            "text": "<p>Fast shipping all the way to WA! The baby carrier and silicone feeding accessories are top notch. Will definitely be ordering our baby essentials here again.</p>",
            "author": "<p>David & Michelle — Perth, WA</p>"
          }
        },
        "testimonial-6": {
          "type": "testimonial",
          "settings": {
            "star_rating": "5",
            "text": "<p>Found so many unique, high-quality baby gifts and essentials that are hard to find elsewhere in Australia. Five stars for quality, speed, and packaging!</p>",
            "author": "<p>Rachel P. — Adelaide, SA</p>"
          }
        }
      },
